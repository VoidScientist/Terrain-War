[gd_resource type="Shader" format=2]

[resource]
code = "shader_type canvas_item;
uniform float shine_range = 0.1;

void fragment() {
	
	vec4 tex_color = texture(TEXTURE, UV);
	
	float time_frac = fract(TIME*2.0);
	
	if (UV.y >= time_frac && UV.y <= min(time_frac + shine_range, 1.0)) {
		
		COLOR = tex_color.a != 0.0 ? vec4(1.0,1.0,1.0,1.0) : vec4(0.0);
		
	} else {
		
		COLOR = tex_color;
		
	}
	
	
	
}"
